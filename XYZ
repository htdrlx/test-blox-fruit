-- Copy toa do vao clipboard
CopyBtn.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local p = hrp.Position
        local str = string.format("%.2f, %.2f, %.2f", p.X, p.Y, p.Z)
        setclipboard(str)
        CopyBtn.Text = "DA COPY!"
        CopyBtn.BackgroundColor3 = Color3.fromRGB(255, 120, 0)
        task.wait(1.5)
        CopyBtn.Text = "COPY TOA DO"
        CopyBtn.BackgroundColor3 = Color3.fromRGB(50, 140, 80)
    end
end)

-- Cap nhat toa do theo thoi gian thuc
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local p = hrp.Position
        LabelX.Text = string.format("%.2f", p.X)
        LabelY.Text = string.format("%.2f", p.Y)
        LabelZ.Text = string.format("%.2f", p.Z)
    else
        LabelX.Text = "---"
        LabelY.Text = "---"
        LabelZ.Text = "---"
    end
end)

