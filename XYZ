-- Tao label hien thi X Y Z
local function MakeLabel(labelText, yPos)
    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, -20, 0, 22)
    Container.Position = UDim2.new(0, 10, 0, yPos)
    Container.BackgroundTransparency = 1
    Container.Parent = Frame

    local Tag = Instance.new("TextLabel")
    Tag.Size = UDim2.new(0, 20, 1, 0)
    Tag.BackgroundTransparency = 1
    Tag.Text = labelText
    Tag.TextColor3 = Color3.fromRGB(255, 120, 0)
    Tag.Font = Enum.Font.GothamBold
    Tag.TextSize = 13
    Tag.TextXAlignment = Enum.TextXAlignment.Left
    Tag.Parent = Container

    local Value = Instance.new("TextLabel")
    Value.Size = UDim2.new(1, -25, 1, 0)
    Value.Position = UDim2.new(0, 25, 0, 0)
    Value.BackgroundTransparency = 1
    Value.Text = "0"
    Value.TextColor3 = Color3.fromRGB(220, 220, 220)
    Value.Font = Enum.Font.Gotham
    Value.TextSize = 13
    Value.TextXAlignment = Enum.TextXAlignment.Left
    Value.Parent = Container

    return Value
end

